# ══════════════════════════════════════════════════════
# RS-Agent 환경 변수 설정
# 이 파일을 복사하여 .env 파일로 저장 후 값을 입력하세요.
# ══════════════════════════════════════════════════════

# ── 외부망(Anthropic) 사용 시 ─────────────────────────
# backend: "anthropic" 으로 설정 시 필요
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── 폐쇄망(로컬 LLM) 사용 시 ─────────────────────────
# backend: "openai_compatible" 또는 "ollama" 으로 설정 시 사용
# config.yaml의 llm.base_url / llm.api_key를 덮어씁니다.

# 로컬 LLM 서버 주소 (Ollama 기본값: http://localhost:11434/v1)
LLM_BASE_URL=http://localhost:11434/v1

# 로컬 LLM API 키 (Ollama는 임의 문자열 사용 가능)
LLM_API_KEY=ollama

# ── 임베딩 모델 (폐쇄망) ──────────────────────────────
# sentence-transformers 모델을 로컬 경로에서 로드하려면
# config.yaml의 solution_space.local_model_path 및
# knowledge_space.local_model_path 에 경로를 지정하세요.
# 예) local_model_path: "/models/all-MiniLM-L6-v2"
#
# 모델 사전 다운로드 방법 (인터넷 환경에서 실행):
#   python -c "from sentence_transformers import SentenceTransformer; \
#              SentenceTransformer('all-MiniLM-L6-v2').save('/models/all-MiniLM-L6-v2')"
